# Native Caddy configuration for Veritech Scan.
#
# Installed at /etc/caddy/Caddyfile by scripts/install-server.sh (and
# re-synced by scripts/deploy.sh on every deploy, followed by
# `systemctl reload caddy`). Caddy is installed via the system package
# manager and runs as its own systemd unit (`caddy.service`, shipped by the
# `caddy` package) — there is no container involved.
{
	email admin@veritechdiligence.com
}

app.veritechdiligence.com {
	encode zstd gzip

	# Conservative request body limit — this app never accepts uploads.
	request_body {
		max_size 5MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	handle /health {
		reverse_proxy 127.0.0.1:8000
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	log {
		output stdout
		format json
	}
}

:80 {
	# Fallback for health checks over plain HTTP / IP access before DNS cutover.
	handle /health {
		reverse_proxy 127.0.0.1:8000
	}
	respond "Veritech Scan" 200
}
