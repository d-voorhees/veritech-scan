[Unit]
Description=Veritech Scan web (Next.js)
After=network.target veritech-scan-api.service
Wants=veritech-scan-api.service

[Service]
Type=simple
User=veritech
Group=veritech
WorkingDirectory=/opt/veritech-scan/app/apps/web
EnvironmentFile=/opt/veritech-scan/app/.env.production
Environment=NODE_ENV=production
Environment=PORT=3000
# package.json's "start" script pins -H 127.0.0.1 -p 3000 (next start binds
# 0.0.0.0 by default) so this never listens on a public interface directly;
# Caddy is the only public listener.
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/veritech-scan/app/apps/web/.next
UMask=0027

[Install]
WantedBy=multi-user.target
