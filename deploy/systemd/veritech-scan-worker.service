[Unit]
Description=Veritech Scan Dramatiq worker (scan collection pipeline)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=veritech
Group=veritech
WorkingDirectory=/opt/veritech-scan/app/apps/api
EnvironmentFile=/opt/veritech-scan/app/.env.production
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/veritech-scan/ms-playwright
ExecStart=/opt/veritech-scan/venv/bin/dramatiq app.tasks.scan_tasks --processes 1 --threads 1
Restart=on-failure
RestartSec=5
# Playwright/Chromium can take a few seconds to shut down cleanly mid-scan.
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/veritech-scan/app /opt/veritech-scan/artifacts
UMask=0027

[Install]
WantedBy=multi-user.target
