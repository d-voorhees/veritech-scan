[Unit]
Description=Veritech Scan API (FastAPI via gunicorn/uvicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=veritech
Group=veritech
WorkingDirectory=/opt/veritech-scan/app/apps/api
EnvironmentFile=/opt/veritech-scan/app/.env.production
Environment=PYTHONUNBUFFERED=1
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/veritech-scan/ms-playwright
ExecStart=/opt/veritech-scan/venv/bin/gunicorn app.main:app \
    -k uvicorn.workers.UvicornWorker \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/veritech-scan/app /opt/veritech-scan/artifacts
UMask=0027

[Install]
WantedBy=multi-user.target
