# ---------------------------------------------------------------------------
# Veritech Scan — environment configuration
# Copy to .env for local development. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Product identity -------------------------------------------------------
APP_ENV=development
APP_DOMAIN=localhost
APP_URL=http://localhost:3000
MARKETING_SITE_URL=https://veritechdiligence.com
PRODUCT_NAME=Veritech Scan
PARENT_BRAND=Veritech Diligence
REPORT_NAME=Technical Acquisition Brief

# Public URL the browser should call the API through. In production this is
# relative (/api) so Caddy can proxy same-origin and CORS never matters.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Postgres ------------------------------------------------------------------
# Native Postgres, localhost/Unix-socket only — never exposed publicly.
# For local dev, create the role/db yourself (see README.md's "Local setup");
# in production, scripts/install-server.sh does this for you.
POSTGRES_DB=veritech_scan
POSTGRES_USER=veritech_scan
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://veritech_scan:change-me@127.0.0.1:5432/veritech_scan

# --- Redis ---------------------------------------------------------------------
# Native Redis, localhost only — never exposed publicly.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth ----------------------------------------------------------------------
JWT_SECRET=replace-with-secure-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me

# --- Scan safety limits ---------------------------------------------------------
SCAN_MAX_TOTAL_MINUTES=10
SCAN_DEFAULT_REQUEST_DELAY_SECONDS=1.5
SCAN_MAX_PAGES=50
SCAN_WORKER_CONCURRENCY=1
SCAN_PAGE_TIMEOUT_SECONDS=15
SCAN_CREATE_RATE_LIMIT_PER_HOUR=10

# --- Optional external providers -------------------------------------------------
GOOGLE_PAGESPEED_API_KEY=
SENTRY_DSN=

# --- Artifact storage ------------------------------------------------------------
# "local" writes to a plain filesystem path. "s3" is a documented future
# extension point (see packages/shared and apps/api/app/services/artifact_storage.py).
# Local dev default is repo-relative (gitignored); production sets this to
# /opt/veritech-scan/artifacts in .env.production.
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_LOCAL_PATH=./artifacts

# --- Playwright ------------------------------------------------------------------
# Leave unset for local dev to use Playwright's default cache
# (~/.cache/ms-playwright). Production sets this to
# /opt/veritech-scan/ms-playwright in .env.production (see
# scripts/install-server.sh).
PLAYWRIGHT_BROWSERS_PATH=
